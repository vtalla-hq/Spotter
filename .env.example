# Optional: turn on accounts (see README → Accounts)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: Formspree/Tally endpoint for the feedback form (otherwise it opens a GitHub issue)
VITE_FEEDBACK_URL=
# Ask (server-side only; never prefix with VITE_)
GROQ_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
SUPABASE_SERVICE_ROLE_KEY=
# Agent orchestrator (orchestrator/), server-side only
ANTHROPIC_API_KEY=
# anthropic (default, Claude) or groq (uses GROQ_API_KEY, AI_BASE_URL, AI_MODEL above)
LLM_PROVIDER=anthropic
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orchestrator
NCBI_API_KEY=
